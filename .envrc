layout_poetry() {
  if [[ ! -f pyproject.toml ]]; then
    log_error 'No pyproject.toml found.  Use `poetry new` or `poetry init` to create one first.'
    exit 2
  fi

  local VENV=$(dirname $(poetry run which python))
  export VIRTUAL_ENV=$(echo "$VENV" | rev | cut -d'/' -f2- | rev)
  export POETRY_ACTIVE=1
  PATH_add "$VENV"
}

layout_uv() {
    if [[ -d ".venv" ]]; then
        VIRTUAL_ENV="$(pwd)/.venv"
    fi

    if [[ -z $VIRTUAL_ENV || ! -d $VIRTUAL_ENV ]]; then
        log_status "No virtual environment exists. Executing \`uv venv\` to create one."
        uv venv
        VIRTUAL_ENV="$(pwd)/.venv"
    fi

    PATH_add "$VIRTUAL_ENV/bin"
    export UV_ACTIVE=1  # or VENV_ACTIVE=1
    export VIRTUAL_ENV
}

DEVENV_VERSION=1.10.0

# Check we have installed the correct devenv version
if ! command -v devenv &> /dev/null; then
    log_error "devenv not found. Please install devenv version $DEVENV_VERSION from https://devenv.sh/getting-started/#2-install-devenv"
    exit 1
fi
if [[ "$(devenv --version | awk '{print $2}')" != "$DEVENV_VERSION" ]]; then
    log_error "Incorrect devenv version. Please install devenv version $DEVENV_VERSION from https://devenv.sh/getting-started/#2-install-devenv"
    exit 1
fi
eval "$(devenv direnvrc)"

use devenv
dotenv

unset PS1
layout_uv
